# ============================================================
# FirsatKaziyici - Environment Variables
# Copy this file to ".env" and fill in your values.
# ============================================================

# Google Gemini API Key
# Get it free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token
# Create a bot with @BotFather on Telegram and get the token.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz

# Target Telegram Chat/Channel ID
# For personal use: find your ID via @useridbot
# For channels: use @channelusername or numeric ID (-100...)
TELEGRAM_CHAT_ID=-1001234567890

# --- Optional Settings ---

# How many hours back to look for posts (default: 106)
LOOKBACK_HOURS=26

# How many last pages to scan per forum (default: 10)
PAGES_TO_SCAN=10

# Delay between requests in seconds (default: 10.0)
REQUEST_DELAY=2.0